    {
      "id": "rss-bmw-pressclub",
      "name": "BMW Group PressClub",
      "kind": "rss",
      "config": {
        "feedUrl": "https://www.press.bmwgroup.com/global/rss",
        "_aihot": {
          "initialBackfillLimit": 8
        }
      },
      "tier": "T1",
      "owner_entity_id": "bmw",
      "participation_mode": "editorial",
      "interval_minutes": 120,
      "tags": [
        "官方"
      ],
      "site_fulltext": false,
      "syndicate_fulltext": false
    },
